# Copy this file to secrets.toml and fill in your own keys.
# .streamlit/secrets.toml is git-ignored and read automatically by Streamlit.

# Optional: enables the full interactive Google Maps JS view with custom pins.
# Without it, the app falls back to embedded map cards (no key required).
GOOGLE_MAPS_API_KEY = ""

# Placeholder Razorpay credentials — used only by the mock payment functions
# in utils/payment.py. No real network calls are made with these.
RAZORPAY_KEY_ID = "rzp_test_placeholder"
RAZORPAY_KEY_SECRET = "placeholder_secret"
